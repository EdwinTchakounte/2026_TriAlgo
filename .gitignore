# =============================================================
# .gitignore  -  racine du depot TRIALGO
# =============================================================
# Les sous-projets ont chacun leur propre .gitignore
# (trialgo/, ok_trialgo_admin/, ok_trialgo_backend/).
# Ce fichier ne traite que ce qui vit a la racine.
# =============================================================

# ---- Binaires d'application ------------------------------------
# Un APK pese ~57 Mo et est entierement reconstructible depuis les
# sources. Git conserve chaque version dans l'historique pour
# toujours : trois APK, c'est 171 Mo qu'on ne pourra plus enlever
# sans reecrire l'historique. Les livrables se distribuent par une
# release, pas par le depot.
*.apk
*.aab
*.ipa

# ---- Signature Android : secrets --------------------------------
*.jks
*.keystore
key.properties

# ---- Documents de travail ---------------------------------------
# Planches d'impression, scans, exports : ces fichiers pesent lourd,
# changent souvent, et git en garde chaque version pour toujours.
# Les sources de travail vivent ailleurs.
#
# ok_logo.jpeg est l'exception explicite ci-dessous : ce n'est pas un
# document de travail mais une ENTREE DE BUILD. vitrine/outils/
# detourer_logo.py en derive tout le dossier vitrine/assets/, et sans
# lui un clone frais ne peut pas regenerer les visuels du site.
*.pdf
*.jpeg
!ok_logo.jpeg
!dictionnaire/*.jpeg

# ---- Systeme ----------------------------------------------------
.DS_Store
Thumbs.db
