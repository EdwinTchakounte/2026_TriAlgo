# =============================================================
# .env.example  -  Variables d'environnement du backend
# =============================================================
# Copier en .env (gitignored) et adapter avant `docker compose up`.
# =============================================================

# ---- API ----
# Hote auquel les clients (Flutter admin, jeu) appellent.
PUBLIC_BASE_URL=http://localhost:8000

# ---- Postgres ----
POSTGRES_USER=trialgo
POSTGRES_PASSWORD=trialgo_dev_change_me
POSTGRES_DB=trialgo
# URL utilisee par SQLAlchemy async (asyncpg).
DATABASE_URL=postgresql+asyncpg://trialgo:trialgo_dev_change_me@postgres:5432/trialgo
# URL utilisee par Alembic (driver sync psycopg2).
ALEMBIC_DATABASE_URL=postgresql://trialgo:trialgo_dev_change_me@postgres:5432/trialgo

# ---- JWT ----
# Generer en local : `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change_me_with_a_long_random_string_at_least_48_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440      # 24h
JWT_REFRESH_EXPIRE_DAYS=30

# ---- Stockage cartes ----
# Backend de storage : "local" (filesystem dans /data) ou "s3" (MinIO/S3).
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=/data/cards

# ---- MinIO / S3 ----
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_dev
S3_SECRET_KEY=minio_dev_secret_change_me
S3_BUCKET=trialgo-cards
S3_REGION=us-east-1

# ---- Upload limits ----
MAX_UPLOAD_BYTES=5242880    # 5 MB
ALLOWED_MIME=image/jpeg,image/png,image/webp
IMAGE_MAX_DIMENSION=1024    # resize si > 1024 px
IMAGE_JPEG_QUALITY=85

# ---- CORS ----
# Adapte avec les origines de tes apps (Flutter web/desktop) si concerne.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Email (Brevo) ----
# Cree un compte sur brevo.com -> Account -> SMTP & API -> API Keys.
# Si vide : envoi log-only (DRY_RUN) -- utile en dev sans cle.
BREVO_API_KEY=
# Adresse expediteur (doit etre verifiee dans Brevo > Senders).
BREVO_SENDER_EMAIL=noreply@trialgo.app
BREVO_SENDER_NAME=TRIALGO
# URL frontale utilisee pour construire les liens dans les emails
# (confirm-email, reset-password). Pointer vers ton app web/landing.
APP_FRONTEND_URL=http://localhost:5173
# TTL des tokens email (minutes).
EMAIL_TOKEN_TTL_RESET_MINUTES=60
EMAIL_TOKEN_TTL_CONFIRM_MINUTES=2880   # 48h
