# =============================================================
# .env.production.example  -  gabarit de configuration PRODUCTION
# =============================================================
# Copier en .env sur le serveur, puis remplacer TOUTES les valeurs
# entre <chevrons>. Le backend verifie ces points au demarrage et
# journalise un bloc CRITICAL pour chaque valeur restee en mode dev
# (voir app/core/startup_checks.py) : lire les logs du premier boot.
#
# Ne jamais committer le .env rempli. En production, injecter ces
# valeurs via le gestionnaire de secrets de la plateforme.
# =============================================================

# ---- API ----
# URL publique de l'API elle-meme. Sert a construire les image_url
# uniquement si STORAGE_BACKEND=local.
PUBLIC_BASE_URL=https://api.mixalgo.com

# ---- DB ----
# Pointer vers une Postgres manageee (RDS, Cloud SQL, Neon...) plutot
# que le conteneur du compose, qui est dimensionne pour le dev.
POSTGRES_USER=trialgo
POSTGRES_PASSWORD=<mot-de-passe-genere>
POSTGRES_DB=trialgo
DATABASE_URL=postgresql+asyncpg://trialgo:<mot-de-passe-genere>@<hote-db>:5432/trialgo
ALEMBIC_DATABASE_URL=postgresql://trialgo:<mot-de-passe-genere>@<hote-db>:5432/trialgo

# ---- JWT ----
# Generer avec :  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changer ce secret invalide instantanement TOUS les jetons emis :
# tous les utilisateurs sont deconnectes. A faire avant l'ouverture
# au public, pas apres.
JWT_SECRET=<48-caracteres-aleatoires>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=30

# ---- Storage ----
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=/data/cards

# ---- S3 / MinIO ----
# S3_ENDPOINT_URL : adresse joignable par le BACKEND (reseau interne).
S3_ENDPOINT_URL=http://minio:9000
#
# S3_PUBLIC_ENDPOINT_URL : LA VARIABLE LA PLUS SENSIBLE DU FICHIER.
# ---------------------------------------------------------------
# Elle est recopiee telle quelle dans chaque champ image_url renvoye
# aux clients :
#     image_url = {S3_PUBLIC_ENDPOINT_URL}/{S3_BUCKET}/{game_id}/{uuid}.jpg
#
# Elle doit donc etre l'adresse joignable depuis un TELEPHONE sur le
# reseau mobile, pas depuis le serveur. Si elle reste sur localhost,
# l'API repondra 200 partout et toutes les cartes s'afficheront
# cassees, sans la moindre erreur cote serveur.
#
# En https imperativement : Android 9+ bloque le trafic en clair.
# Le suffixe /files correspond au bloc handle_path du Caddyfile,
# qui retire ce prefixe avant de transmettre a MinIO. Ne pas mettre
# de slash final : le backend concatene deja "/<bucket>/<cle>".
S3_PUBLIC_ENDPOINT_URL=https://api.mixalgo.com/files
S3_ACCESS_KEY=<cle-minio-generee>
S3_SECRET_KEY=<secret-minio-genere>
S3_BUCKET=trialgo-cards
S3_REGION=us-east-1

# ---- Upload ----
MAX_UPLOAD_BYTES=5242880
ALLOWED_MIME=image/jpeg,image/png,image/webp
IMAGE_MAX_DIMENSION=1024
IMAGE_JPEG_QUALITY=85

# ---- CORS ----
# Origines EXACTES du front web : schema + domaine + port si non
# standard, sans slash final. Une origine absente de cette liste voit
# son preflight refuse (HTTP 400) et l'app web ne peut rien appeler.
# Sans app web deployee, laisser vide.
CORS_ALLOWED_ORIGINS=https://dashboard.mixalgo.com,https://mixalgo.com

# ---- Email (Brevo) ----
# Sans cle, les emails sont seulement journalises (DRY_RUN) : la
# confirmation de compte et la reinitialisation de mot de passe
# deviennent inoperantes.
# Le sender doit etre un expediteur verifie dans Brevo (DKIM recommande).
BREVO_API_KEY=<xkeysib-...>
BREVO_SENDER_EMAIL=noreply@mixalgo.com
BREVO_SENDER_NAME=TRIALGO

# APP_FRONTEND_URL : base des liens de confirmation et de reset
# inseres dans les emails. Doit etre publiquement joignable.
APP_FRONTEND_URL=https://dashboard.mixalgo.com

EMAIL_TOKEN_TTL_RESET_MINUTES=60
EMAIL_TOKEN_TTL_CONFIRM_MINUTES=2880
