<?xml version="1.0" encoding="utf-8"?>
<!--
  Icone adaptative, lue par Android 8 et plus.
  Le lanceur compose lui-meme le fond et l'avant-plan dans la
  forme du systeme. Sans ce fichier, il appliquerait a
  ic_launcher.png un masque automatique qui la retrecit et la
  pose sur du blanc.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
