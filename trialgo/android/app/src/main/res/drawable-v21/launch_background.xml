<?xml version="1.0" encoding="utf-8"?>
<!--
     ECRAN DE LANCEMENT

     Android peint cette fenetre pendant que le processus demarre,
     AVANT que Flutter ne dessine sa premiere image. Le gabarit de
     Flutter y mettait @android:color/white : sur un telephone en
     theme clair, c'est a dire le reglage par defaut, le joueur
     voyait donc un ecran BLANC avant une application entierement
     sombre. Un eclair blanc a chaque lancement.

     Le fond reprend la couleur de fond de l'application elle meme,
     et le logo nomme le produit pendant l'attente.

     Aucun tiret double dans ce commentaire : la specification XML
     l'interdit, et le compilateur de ressources Android echoue
     alors sur "The string is not permitted within comments".
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
